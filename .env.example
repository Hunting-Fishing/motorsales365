# ---------------------------------------------------------------------------
# 365 MotorSales — environment reference (names only; never commit secrets).
#
# Public build-time values (VITE_*) live in the committed .env files.
# Server secrets are set on the Cloudflare Worker "motorsales365":
#   npx wrangler secret put NAME     (or Dashboard → Workers → Settings → Variables)
# For local dev put server values in .dev.vars (git-ignored).
# ---------------------------------------------------------------------------

# Supabase (standalone project wjxaajgvddtrxxtocxen) — public
VITE_SUPABASE_URL=https://wjxaajgvddtrxxtocxen.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=wjxaajgvddtrxxtocxen
SUPABASE_URL=https://wjxaajgvddtrxxtocxen.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Supabase — secret
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — public publishable key (per mode, see .env.development/.env.production)
VITE_PAYMENTS_CLIENT_TOKEN=
# Stripe — secret keys from dashboard.stripe.com → Developers → API keys (sk_/rk_)
STRIPE_LIVE_API_KEY=
STRIPE_SANDBOX_API_KEY=
# Stripe webhook signing secrets (whsec_...) for /api/public/payments/webhook
PAYMENTS_LIVE_WEBHOOK_SECRET=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=

# AI — any OpenAI-compatible endpoint (default: Google Gemini via AI Studio key)
AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=
# AI_MODEL_MAP={"gemini-2.5-flash":"gemini-2.5-flash","gemini-3-flash-preview":"gemini-3-flash-preview"}

# Google Maps Platform server key (Places API (New) + Geocoding API)
GOOGLE_MAPS_API_KEY=

# Email (Resend)
# EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Resend → Webhooks signing secret (whsec_...) for /api/email/events
RESEND_WEBHOOK_SECRET=
# Supabase → Auth → Hooks → Send Email secret (v1,whsec_...) for /api/email/auth-hook
SEND_EMAIL_HOOK_SECRET=
# EMAIL_FROM="motorsales365 <noreply@365motorsales.com>"

# Other integrations (unchanged by the platform exit)
FIRECRAWL_API_KEY=
GIPHY_API_KEY=
INVOLVE_ASIA_API_KEY_NAME=
INVOLVE_ASIA_API_SECRET=
INVOLVE_ASIA_AFFILIATE_ID=
SIGNUP_AUDIT_SALT=
# SITE_URL / PUBLIC_SITE_ORIGIN / VITE_SITE_URL / VITE_PUBLIC_SITE_ORIGIN default to https://www.365motorsales.com
