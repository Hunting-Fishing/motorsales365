  "policies": [
    {
      "name": "Block direct inserts",
      "check": "false",
      "roles": [
        "authenticated"
      ],
      "table": "business_claim_audit",
      "using": null,
      "command": "INSERT",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Read own claim audit or mod",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "business_claim_audit",
      "using": "(public.can_moderate(auth.uid()) OR (EXISTS ( SELECT 1\n   FROM public.business_claim_requests c\n  WHERE ((c.id = business_claim_audit.claim_id) AND (c.claimant_user_id = auth.uid())))))",
      "command": "SELECT",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Staff update claims",
      "check": "public.can_moderate(auth.uid())",
      "roles": [
        "authenticated"
      ],
      "table": "business_claim_requests",
      "using": "public.can_moderate(auth.uid())",
      "command": "UPDATE",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Users read own claims",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "business_claim_requests",
      "using": "((claimant_user_id = auth.uid()) OR public.can_moderate(auth.uid()))",
      "command": "SELECT",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Users submit own claim",
      "check": "((claimant_user_id = auth.uid()) AND (EXISTS ( SELECT 1\n   FROM public.businesses b\n  WHERE ((b.id = business_claim_requests.business_id) AND (((business_claim_requests.kind = 'claim'::text) AND (b.claim_state = ANY (ARRAY['unclaimed'::text, 'claim_pending'::text])) AND (b.owner_id IS NULL)) OR ((business_claim_requests.kind = 'transfer'::text) AND (b.owner_id IS NOT NULL) AND (b.owner_id <> auth.uid())))))))",
      "roles": [
        "authenticated"
      ],
      "table": "business_claim_requests",
      "using": null,
      "command": "INSERT",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Active businesses public read",
      "check": null,
      "roles": [
        "public"
      ],
      "table": "businesses",
      "using": "(status = 'active'::public.business_status)",
      "command": "SELECT",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Business owners can read own businesses",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "businesses",
      "using": "(auth.uid() = owner_id)",
      "command": "SELECT",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Moderators manage businesses",
      "check": "public.can_moderate(auth.uid())",
      "roles": [
        "authenticated"
      ],
      "table": "businesses",
      "using": "public.can_moderate(auth.uid())",
      "command": "ALL",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Owners delete own businesses",
      "check": null,
      "roles": [
        "public"
      ],
      "table": "businesses",
      "using": "(auth.uid() = owner_id)",
      "command": "DELETE",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Owners insert businesses",
      "check": "((auth.uid() = owner_id) AND (status = 'pending'::public.business_status))",
      "roles": [
        "public"
      ],
      "table": "businesses",
      "using": null,
      "command": "INSERT",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Owners update own businesses",
      "check": "(auth.uid() = owner_id)",
      "roles": [
        "authenticated"
      ],
      "table": "businesses",
      "using": "(auth.uid() = owner_id)",
      "command": "UPDATE",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Public can resolve verified custom domains",
      "check": null,
      "roles": [
        "anon",
        "authenticated"
      ],
      "table": "businesses",
      "using": "((custom_domain IS NOT NULL) AND (custom_domain_status = 'verified'::text))",
      "command": "SELECT",
      "permissive": "PERMISSIVE"
    }
  ],
