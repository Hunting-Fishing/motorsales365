  "policies": [
    {
      "name": "Admins read admin audit",
      "check": null,
      "roles": [
        "public"
      ],
      "table": "admin_audit_log",
      "using": "public.has_role(auth.uid(), 'admin'::public.app_role)",
      "command": "SELECT",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Admins write admin audit",
      "check": "(public.has_role(auth.uid(), 'admin'::public.app_role) AND (auth.uid() = actor_id))",
      "roles": [
        "public"
      ],
      "table": "admin_audit_log",
      "using": null,
      "command": "INSERT",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Support read admin audit",
      "check": null,
      "roles": [
        "public"
      ],
      "table": "admin_audit_log",
      "using": "public.can_support(auth.uid())",
      "command": "SELECT",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Admins can manage all profiles",
      "check": null,
      "roles": [
        "public"
      ],
      "table": "profiles",
      "using": "public.has_role(auth.uid(), 'admin'::public.app_role)",
      "command": "ALL",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Sales view assigned profiles",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "profiles",
      "using": "(public.has_role(auth.uid(), 'sales'::public.app_role) AND public.is_sales_assigned_user(auth.uid(), id))",
      "command": "SELECT",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Support read profiles",
      "check": null,
      "roles": [
        "public"
      ],
      "table": "profiles",
      "using": "public.can_support(auth.uid())",
      "command": "SELECT",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Users can insert own profile",
      "check": "((auth.uid() = id) AND (is_staff_account = false))",
      "roles": [
        "authenticated"
      ],
      "table": "profiles",
      "using": null,
      "command": "INSERT",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Users can update own profile",
      "check": "((auth.uid() = id) AND (NOT (verification_status IS DISTINCT FROM ( SELECT p.verification_status\n   FROM public.profiles p\n  WHERE (p.id = auth.uid())))) AND (NOT (verified_at IS DISTINCT FROM ( SELECT p.verified_at\n   FROM public.profiles p\n  WHERE (p.id = auth.uid())))) AND (NOT (is_founding_member IS DISTINCT FROM ( SELECT p.is_founding_member\n   FROM public.profiles p\n  WHERE (p.id = auth.uid())))) AND (NOT (founding_member_number IS DISTINCT FROM ( SELECT p.founding_member_number\n   FROM public.profiles p\n  WHERE (p.id = auth.uid())))) AND (NOT (account_status IS DISTINCT FROM ( SELECT p.account_status\n   FROM public.profiles p\n  WHERE (p.id = auth.uid())))) AND (NOT (is_staff_account IS DISTINCT FROM ( SELECT p.is_staff_account\n   FROM public.profiles p\n  WHERE (p.id = auth.uid())))))",
      "roles": [
        "authenticated"
      ],
      "table": "profiles",
      "using": "(auth.uid() = id)",
      "command": "UPDATE",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Users can view own profile",
      "check": null,
      "roles": [
        "public"
      ],
      "table": "profiles",
      "using": "(auth.uid() = id)",
      "command": "SELECT",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Admins manage roles",
      "check": null,
      "roles": [
        "public"
      ],
      "table": "user_roles",
      "using": "public.has_role(auth.uid(), 'admin'::public.app_role)",
      "command": "ALL",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Sales view user_roles",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "user_roles",
      "using": "(public.has_role(auth.uid(), 'sales'::public.app_role) AND public.is_sales_assigned_user(auth.uid(), user_id))",
      "command": "SELECT",
      "permissive": "PERMISSIVE"
    },
    {
      "name": "Users can view own roles",
      "check": null,
      "roles": [
        "public"
      ],
      "table": "user_roles",
      "using": "((auth.uid() = user_id) OR public.has_role(auth.uid(), 'admin'::public.app_role))",
      "command": "SELECT",
      "permissive": "PERMISSIVE"
    }
  ],
