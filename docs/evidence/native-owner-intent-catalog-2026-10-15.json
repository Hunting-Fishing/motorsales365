      "signature": "public.trg_profiles_recompute_intent()",
      "definition": "CREATE OR REPLACE FUNCTION public.trg_profiles_recompute_intent()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nBEGIN\n  IF TG_OP = 'INSERT' THEN\n    PERFORM public.recompute_signup_intent(\n      NEW.id,\n      'profile_insert',\n      'seller_type', NULL::text, NEW.seller_type::text,\n      'profile', NEW.id::text\n    );\n  ELSIF NEW.seller_type IS DISTINCT FROM OLD.seller_type THEN\n    PERFORM public.recompute_signup_intent(\n      NEW.id,\n      'seller_type_changed',\n      'seller_type', OLD.seller_type::text, NEW.seller_type::text,\n      'profile', NEW.id::text\n    );\n  END IF;\n  RETURN NEW;\nEND;\n$function$\n",
